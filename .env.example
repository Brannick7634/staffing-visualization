# Airtable Configuration — SERVER-SIDE ONLY (no VITE_ prefix).
# These are read by the serverless functions under /api/, never by the
# browser bundle. Do NOT rename these back to VITE_* — that would put the
# real key back in client-side JavaScript, which is the exact issue this
# .env.example was rewritten to fix (see api/_lib/airtableServer.js).
#
# Get your API key from: https://airtable.com/create/tokens
# Get your Base ID from the Airtable API docs for your base

AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=test

# Table and View configuration
AIRTABLE_COMPANY_TABLE=Company Details
AIRTABLE_COMPANY_VIEW=Staffing Signal View
AIRTABLE_COMPANY_URL_FIELD=Sales Navigator Company URL
AIRTABLE_JOBS_TABLE=Linkedin Jobs
# DashboardMetrices needs a Single line text field named `type`
# with values: dashboard | job_signals
