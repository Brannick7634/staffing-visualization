{
  "redirects": [
    {
      "source": "/api/auth/verify",
      "destination": "/sign-in",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(client-report|preferences|email-preferences|sign-in|forgot-password|reset-password|confirm-email|free-access|login|signup|dashboard|company-data|market-intel|preview)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/subscribe",
      "destination": "/api/account?route=subscribe"
    },
    {
      "source": "/api/auth/login",
      "destination": "/api/account?route=login"
    },
    {
      "source": "/api/auth/forgot",
      "destination": "/api/account?route=forgot"
    },
    {
      "source": "/api/auth/reset",
      "destination": "/api/account?route=reset"
    },
    {
      "source": "/api/auth/confirm",
      "destination": "/api/account?route=confirm"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/account?route=logout"
    },
    {
      "source": "/api/unsubscribe",
      "destination": "/api/account?route=unsubscribe"
    },
    {
      "source": "/api/preferences",
      "destination": "/api/account?route=preferences"
    },
    {
      "source": "/api/signal/snapshot",
      "destination": "/api/signal-data?route=signal-snapshot"
    },
    {
      "source": "/api/signal/pay",
      "destination": "/api/signal-data?route=signal-pay"
    },
    {
      "source": "/api/signal/report",
      "destination": "/api/signal-data?route=signal-report"
    },
    {
      "source": "/api/signal/client-report/email",
      "destination": "/api/signal-data?route=client-report-email"
    },
    {
      "source": "/api/track",
      "destination": "/api/account?route=track"
    },
    {
      "source": "/api/analytics/weekly",
      "destination": "/api/account?route=analytics-weekly"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/dashboard-metrics?recompute=1",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/analytics/weekly",
      "schedule": "0 12 * * 1"
    }
  ],
  "functions": {
    "api/signal-data.js": {
      "includeFiles": "{api/_lib/signal/data/report/**,api/_lib/signal/data/monthly/**,node_modules/pdfkit/js/standard-fonts/**}"
    }
  }
}
